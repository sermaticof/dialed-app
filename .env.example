# Google service account JSON, pasted as a single line.
# Share every client sheet (or the parent Drive folder) with this
# account's client_email as a Viewer.
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"dialed@....iam.gserviceaccount.com"}

# Passcode for the app. Anyone with this can read every client's data.
DIALED_PASSCODE=choose-something-long

# Random string used to sign the session cookie. Rotate to log everyone out.
DIALED_SESSION_SECRET=another-long-random-string

# Optional: restrict discovery to one Drive folder (the "Active clients" folder).
# Leave unset to find every sheet named "<Name> - TBD Guide" the account can see.
ACTIVE_FOLDER_ID=

# Optional: override the sheet naming convention. Default: "TBD Guide".
SHEET_NAME_MATCH=TBD Guide

# Optional: an Upstash Redis for the cache. Add "Upstash" from the Vercel
# Marketplace and it injects these for you. Without them the app still works,
# it just re-reads every sheet after a cold start instead of within ~10 min.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
